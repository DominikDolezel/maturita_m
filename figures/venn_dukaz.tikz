\begin{tikzpicture}[
      scale=1.2,
      set/.style={thick, draw=black},
      univ/.style={thick, draw=black},
      fillcolor/.style={fill=green!50},
      hatchcolor/.style={pattern=north west lines, pattern color=gray!80},
      altfillcolor/.style={fill=yellow!30}
  ]

  \def\universe{(-2.5,-1.5) rectangle (2.5,1.5)}
  \def\setA{(-0.7,0) circle (1.1)}
  \def\setB{(0.7,0) circle (1.1)}

  % 1. Vlevo nahoře: A \cup B
  \begin{scope}[shift={(0,0)}]
      \fill[fillcolor] \setA;
      \fill[fillcolor] \setB;
      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$(A \cup B)$};
  \end{scope}

  % 2. Vlevo dole: (A \cup B)'
  \begin{scope}[shift={(0,-4.5)}]
      \fill[fillcolor] \universe;
      \fill[white] \setA;
      \fill[white] \setB;
      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$(A \cup B)'$};
  \end{scope}

  % 3. Vpravo nahoře: Zobrazení A' a B'
  \begin{scope}[shift={(6,0)}]
      % A' je žlutě (vše mimo A)
      \fill[altfillcolor, even odd rule] \setA \universe;
      % B' je šedě šrafovaně (vše mimo B)
      \fill[hatchcolor, even odd rule] \setB \universe;

      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$A'$ a $B'$};
  \end{scope}

  % 4. Vpravo dole: A' \cap B'
  \begin{scope}[shift={(6,-4.5)}]
      \fill[fillcolor] \universe;
      \fill[white] \setA;
      \fill[white] \setB;
      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$A' \cap B'$};
  \end{scope}

  % 5.
  \begin{scope}[shift={(14,0)}]
      \fill[fillcolor] \setA \setB;
      \fill[white, even odd rule] \setA \setB;
      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$(A \cap B)$};
  \end{scope}

  % 6.
  \begin{scope}[shift={(14,-4.5)}]

      \fill[fillcolor] \universe;
      \fill[white] \setA;
      \fill[fillcolor, even odd rule] \setA \setB;
      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$(A \cap B)'$};
  \end{scope}


  % 7.
  \begin{scope}[shift={(20,0)}]
      % A' je žlutě (vše mimo A)
      \fill[altfillcolor, even odd rule] \setA \universe;
      % B' je šedě šrafovaně (vše mimo B)
      \fill[hatchcolor, even odd rule] \setB \universe;

      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$A'$ a $B'$};
  \end{scope}

  % 8.
  \begin{scope}[shift={(20,-4.5)}]
      \fill[fillcolor] \universe;
      \fill[white] \setA;
      \fill[fillcolor, even odd rule] \setA \setB;
      \draw[univ] \universe;
      \node[above left] at (2.5,-1.5) {$U$};
      \draw[set] \setA;
      \node[above left] at (-1.3,0.7) {$A$};
      \draw[set] \setB;
      \node[above right] at (1.3,0.7) {$B$};
      \node at (0,-2) {$A' \cup B'$};
  \end{scope}
  \end{tikzpicture}
