
	\begin{tikzpicture}[scale=2]

    % --- Vzorkový prostor \Omega ---
    \draw[thick, fill=gray!5, rounded corners=4pt] (0,0) rectangle (10,5);
    \node[anchor=north west, font=\Large\bfseries] at (0.2, 4.8) {$\Omega$};

    % --- Partice B_1, B_2, ..., B_5 ---
    \draw[dashed, thick, gray!80] (2,0) -- (2,5);
    \draw[dashed, thick, gray!80] (4,0) -- (4,5);
    \draw[dashed, thick, gray!80] (6,0) -- (6,5);
    \draw[dashed, thick, gray!80] (8,0) -- (8,5);

    % Popisy disjunktních jevů B_i
    \node[font=\large\bfseries, color=gray!80!black] at (1, 4.5) {$B_1$};
    \node[font=\large\bfseries, color=gray!80!black] at (3, 4.5) {$B_2$};
    \node[font=\large\bfseries, color=gray!80!black] at (5, 4.5) {$B_3$};
    \node[font=\large\bfseries, color=gray!80!black] at (7, 4.5) {$B_4$};
    \node[font=\large\bfseries, color=gray!80!black] at (9, 4.5) {$B_5$};

    % --- Jev A ---
    \def\eventA{(5, 2.2) ellipse (3.5cm and 1.5cm)}

    % Vyplnění jednotlivých průniků (A \cap B_i)
    \begin{scope}
        \clip (0,0) rectangle (2,5);
        \fill[blue!15] \eventA;
    \end{scope}
    \begin{scope}
        \clip (2,0) rectangle (4,5);
        \fill[blue!25] \eventA;
    \end{scope}
    \begin{scope}
        \clip (4,0) rectangle (6,5);
        \fill[blue!35] \eventA;
    \end{scope}
    \begin{scope}
        \clip (6,0) rectangle (8,5);
        \fill[blue!25] \eventA;
    \end{scope}
    \begin{scope}
        \clip (8,0) rectangle (10,5);
        \fill[blue!15] \eventA;
    \end{scope}

    % Obrys jevu A
    \draw[line width=1.5pt, blue!80!black] \eventA;

    % Popisky průniků A \cap B_i
    \node[font=\small] at (1.4, 1.4) {$A \cap B_1$};
    \node[font=\small] at (3.0, 2.2) {$A \cap B_2$};
    \node[font=\small] at (5.0, 3.1) {$A \cap B_3$};
    \node[font=\small] at (7.0, 2.2) {$A \cap B_4$};
    \node[font=\small] at (8.6, 1.4) {$A \cap B_5$};

    % Popis celého jevu A
    \node[font=\Large\bfseries, blue!80!black] at (5, 1.7) {$A$};

	\end{tikzpicture}
