
	\begin{tikzpicture}[tdplot_main_coords, scale=2.8]
		\coordinate (A) at (0, 0, 0);
		\coordinate (B) at (2, 0, 0);
		\coordinate (C) at (2,2,0);
		\coordinate (D) at (0, 2, 0);
		\coordinate (V) at (1,1, 3);
		\coordinate (S) at (1,1, 0);
		\coordinate (X) at (1,0,0);

		\draw[thick] (A) -- (B) -- (C);
		\draw[thick, dashed, blue] (C) -- (D);
	    \draw[thick, dashed] (D) -- (A);
		\draw[blue, thick] (A) -- (V);
		\draw[thick] (B) --(V);
		\draw[thick] (C) -- (V);
		\draw[thick] (D) -- (V);
		\draw[dashed] (S) -- (V);
		\draw[dashed] (A) -- (S);
		\draw[dashed] (S)--(X)--(V);

		\node[below left] at (A) {$A$};
		\node[below right] at (B) {$B$};
		\node[right] at (C) {$C$};
		\node[left] at (D) {$D$};
		\node[above] at (V) {$V$};
		\node[below right] at (S) {$S$};
		\node[below left] at (X) {$X$};
	\end{tikzpicture}
