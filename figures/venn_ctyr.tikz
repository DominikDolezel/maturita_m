\begin{tikzpicture}[
      scale=2.2,
      set line/.style={draw=black, rounded corners=2.5mm, semithick},
      box/.style={draw=black, semithick}
  ]

  % Vlevo nahoře (2 množiny)
  \begin{scope}[shift={(0, 3)}]
      \draw[box] (0,0) rectangle (4,2.5);
      \node[anchor=north west, inner sep=3pt] at (0,2.5) {$U$};

      % Nahrazeno z (1,0) |- (4,0.9)
      \draw[set line] (1,0) -- (1,0.9) -- (4,0.9);
      \node at (0.7, 0.9) {$A$};

      % Nahrazeno z (2.8,0) |- (4,2.1)
      \draw[set line] (2.8,0) -- (2.8,2.1) -- (4,2.1);
      \node at (2.5, 2.1) {$B$};
  \end{scope}

  % Vpravo nahoře (3 množiny)
  \begin{scope}[shift={(4.5, 3)}]
      \draw[box] (0,0) rectangle (4,2.5);
      \node[anchor=north west, inner sep=3pt] at (0,2.5) {$U$};

      \draw[set line] (1,0) -- (1,0.9) -- (4,0.9);
      \node at (0.7, 0.9) {$A$};

      \draw[set line] (2.3,0) -- (2.3,1.7) -- (3.2,1.7) -- (3.2,0);
      \node at (2.0, 1.7) {$B$};

      \draw[set line] (2.8,0) -- (2.8,2.1) -- (4,2.1);
      \node at (2.5, 2.1) {$C$};
  \end{scope}

  % Vlevo dole (4 množiny)
  \begin{scope}[shift={(0, 0)}]
      \draw[box] (0,0) rectangle (4,2.5);
      \node[anchor=north west, inner sep=3pt] at (0,2.5) {$U$};

      \draw[set line] (1,0) -- (1,0.9) -- (4,0.9);
      \node at (0.7, 0.9) {$A$};

      \draw[set line] (4,0.4) -- (1.5,0.4) -- (1.5,1.4) -- (4,1.4);
      \node at (1.2, 1.4) {$B$};

      \draw[set line] (2.5,0) -- (2.5,1.8) -- (3.3,1.8) -- (3.3,0);
      \node at (2.2, 1.8) {$C$};

      \draw[set line] (3.0,0) -- (3.0,2.2) -- (4,2.2);
      \node at (2.7, 2.2) {$D$};
  \end{scope}

  % Vpravo dole (4 množiny - alternativní zobrazení)
  \begin{scope}[shift={(4.5, 0)}]
      \draw[box] (0,0) rectangle (4,2.5);
      \node[anchor=north west, inner sep=3pt] at (0,2.5) {$U$};

      \draw[set line] (1,0) -- (1,0.9) -- (4,0.9);
      \node at (0.7, 0.9) {$A$};

      \draw[set line] (1.5,0.3) rectangle (3.7,1.3);
      \node at (1.2, 1.3) {$B$};

      \draw[set line] (2.1,0.1) rectangle (3.2,1.7);
      \node at (1.8, 1.7) {$C$};

      \draw[set line] (2.8,0) -- (2.8,2.1) -- (4,2.1);
      \node at (2.5, 2.1) {$D$};
  \end{scope}

  \end{tikzpicture}
