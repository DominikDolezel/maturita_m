
  \begin{tikzpicture}[x=1cm, y=1cm, scale=1.4, transform shape]

    % Styl pro nadpisy a rovnice
    \tikzset{
      title/.style={
        font=\boldmath\bfseries\Large,
        anchor=center,          % Zarovnání názvu na střed
        text=myblue,
        inner sep=0pt
      },
      eq/.style={
        font=\boldmath\bfseries\LARGE,
        text=myblue,
        inner sep=0pt
      }
    }

    % =========================================================================
    % HORNÍ ŘÁDEK
    % =========================================================================

    % 1. VRCHOLOVÉ
    \begin{scope}[shift={(0,0)}]
      \node[title] at (2.5, 3.9) {vrcholové};
      \draw[gray, thick] (0.5, 0.4) -- (4.5, 2.0);
      \draw[gray, thick] (0.5, 2.0) -- (4.5, 0.4);
      % Oblouky
      \draw[myblue, very thick] (2.5, 1.2) ++(-21.8:0.8) arc (-21.8:21.8:0.8);
      \draw[myblue, very thick] (2.5, 1.2) ++(158.2:0.8) arc (158.2:201.8:0.8);
      % Popisky (posunuty dál od čar a oblouků)
      \node[myblue, font=\LARGE] at (2.5, 1.2) [shift={(0:1.3)}] {$\alpha$};
      \node[myblue, font=\LARGE] at (2.5, 1.2) [shift={(180:1.3)}] {$\beta$};
      % Rovnice
      \node[eq] at (2.5, -0.6) {$\alpha = \beta$};
    \end{scope}

    % 2. DOPLŇKOVÉ
    \begin{scope}[shift={(6,0)}]
      \node[title] at (2.5, 3.9) {doplňkové};
      \draw[gray, thick] (1.0, 0.5) -- (4.0, 0.5);
      \draw[gray, thick] (1.0, 0.5) -- (1.0, 3.5);
      \draw[gray, thick] (1.0, 0.5) -- (3.5, 3.0);
      % Značka pravého úhlu
      \draw[gray, thin] (1.3, 0.5) -- (1.3, 0.8) -- (1.0, 0.8);
      \fill[gray] (1.15, 0.65) circle (1.5pt);
      % Oblouky
      \draw[myblue, very thick] (1.0, 0.5) ++(0:1.2) arc (0:45:1.2);
      \draw[myred, very thick] (1.0, 0.5) ++(45:1.2) arc (45:90:1.2);
      % Popisky (posunuty dál od čar a oblouků)
      \node[myblue, font=\LARGE] at (1.0, 0.5) [shift={(22.5:1.8)}] {$\alpha$};
      \node[myred, font=\LARGE] at (1.0, 0.5) [shift={(67.5:1.8)}] {$\beta$};
      % Rovnice
      \node[eq] at (2.5, -0.6) {$\alpha + \beta = 90^\circ$};
    \end{scope}

    % 3. VEDLEJŠÍ
    \begin{scope}[shift={(12,0)}]
      \node[title] at (2.5, 3.9) {vedlejší};
      \draw[gray, thick] (0.5, 0.5) -- (4.5, 0.5);
      \draw[gray, thick] (2.5, 0.5) -- (3.5, 3.0);
      % Oblouky
      \draw[myblue, very thick] (2.5, 0.5) ++(0:1.0) arc (0:68.2:1.0);
      \draw[myred, very thick] (2.5, 0.5) ++(68.2:1.0) arc (68.2:180:1.0);
      % Popisky (posunuty dál od čar a oblouků)
      \node[myblue, font=\LARGE] at (2.5, 0.5) [shift={(34.1:1.6)}] {$\alpha$};
      \node[myred, font=\LARGE] at (2.5, 0.5) [shift={(124.1:1.6)}] {$\beta$};
      % Rovnice
      \node[eq] at (2.5, -0.6) {$\alpha + \beta = 180^\circ$};
    \end{scope}


    % =========================================================================
    % SPODNÍ ŘÁDEK
    % =========================================================================

    % 4. SOUHLASNÉ
    \begin{scope}[shift={(0,-6.5)}]
      \node[title] at (2.5, 3.9) {souhlasné};
      \draw[gray, thick] (0.5, 0.5) -- (4.5, 0.5);
      \draw[gray, thick] (0.5, 2.5) -- (4.5, 2.5);
      \draw[gray, thick] (1.5, -0.5) -- (3.5, 3.5);
      % Značky rovnoběžek (||)
      \draw[gray, thick] (0.92, 0.35) -- (0.92, 0.65); \draw[gray, thick] (1.08, 0.35) -- (1.08, 0.65);
      \draw[gray, thick] (0.92, 2.35) -- (0.92, 2.65); \draw[gray, thick] (1.08, 2.35) -- (1.08, 2.65);
      % Oblouky
      \draw[myblue, very thick] (2.0, 0.5) ++(0:0.9) arc (0:63.4:0.9);
      \draw[myblue, very thick] (3.0, 2.5) ++(0:0.9) arc (0:63.4:0.9);
      % Popisky (posunuty dál od čar a oblouků)
      \node[myblue, font=\LARGE] at (2.0, 0.5) [shift={(31.7:1.5)}] {$\alpha$};
      \node[myblue, font=\LARGE] at (3.0, 2.5) [shift={(31.7:1.5)}] {$\beta$};
      % Rovnice
      \node[eq] at (2.5, -1.3) {$\alpha = \beta$};
    \end{scope}

    % 5. STŘÍDAVÉ
    \begin{scope}[shift={(6,-6.5)}]
      \node[title] at (2.5, 3.9) {střídavé};
      \draw[gray, thick] (0.5, 0.5) -- (4.5, 0.5);
      \draw[gray, thick] (0.5, 2.5) -- (4.5, 2.5);
      \draw[gray, thick] (1.5, -0.5) -- (3.5, 3.5);
      % Značky rovnoběžek (||)
      \draw[gray, thick] (0.92, 0.35) -- (0.92, 0.65); \draw[gray, thick] (1.08, 0.35) -- (1.08, 0.65);
      \draw[gray, thick] (0.92, 2.35) -- (0.92, 2.65); \draw[gray, thick] (1.08, 2.35) -- (1.08, 2.65);
      % Oblouky
      \draw[myblue, very thick] (2.0, 0.5) ++(0:0.9) arc (0:63.4:0.9);
      \draw[myblue, very thick] (3.0, 2.5) ++(180:0.9) arc (180:243.4:0.9);
      % Popisky (posunuty dál od čar a oblouků)
      \node[myblue, font=\LARGE] at (2.0, 0.5) [shift={(31.7:1.5)}] {$\alpha$};
      \node[myblue, font=\LARGE] at (3.0, 2.5) [shift={(211.7:1.5)}] {$\beta$};
      % Rovnice
      \node[eq] at (2.5, -1.3) {$\alpha = \beta$};
    \end{scope}

    % 6. PŘILEHLÉ
    \begin{scope}[shift={(12,-6.5)}]
      \node[title] at (2.5, 3.9) {přilehlé};
      \draw[gray, thick] (0.5, 0.5) -- (4.5, 0.5);
      \draw[gray, thick] (0.5, 2.5) -- (4.5, 2.5);
      \draw[gray, thick] (1.5, -0.5) -- (3.5, 3.5);
      % Značky rovnoběžek (||)
      \draw[gray, thick] (0.92, 0.35) -- (0.92, 0.65); \draw[gray, thick] (1.08, 0.35) -- (1.08, 0.65);
      \draw[gray, thick] (0.92, 2.35) -- (0.92, 2.65); \draw[gray, thick] (1.08, 2.35) -- (1.08, 2.65);
      % Oblouky
      \draw[myblue, very thick] (2.0, 0.5) ++(0:0.9) arc (0:63.4:0.9);
      \draw[myred, very thick] (3.0, 2.5) ++(243.4:0.9) arc (243.4:360:0.9);
      % Popisky (posunuty dál od čar a oblouků)
      \node[myblue, font=\LARGE] at (2.0, 0.5) [shift={(31.7:1.5)}] {$\alpha$};
      \node[myred, font=\LARGE] at (3.0, 2.5) [shift={(301.7:1.5)}] {$\beta$};
      % Rovnice
      \node[eq] at (2.5, -1.3) {$\alpha + \beta = 180^\circ$};
    \end{scope}

  \end{tikzpicture}
