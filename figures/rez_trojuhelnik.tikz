
	\begin{tikzpicture}[scale=3]
		\coordinate (A) at (0,0);
		\coordinate (B) at (2, 0);
		\coordinate (V) at (1, 3);
		\coordinate (S) at (1,0);

		\draw [thick] (A)--(B)--(V) --cycle;
		\draw [dashed] (S)--(V);

		\node[below left] at (A) {$A$};
		\node[below right] at (B) {$B$};
		\node[above] at (V) {$V$};
		\node[below] at (S) {$X$};
	\end{tikzpicture}
