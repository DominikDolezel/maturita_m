
	\begin{tikzpicture}[scale=2, >=stealth]
    % --- KOOORDINÁTY ---
    \coordinate (A) at (0,0);
    \coordinate (B) at (3.5,0);
    \coordinate (P) at (6,0);
    \coordinate (V) at (6,4);

    % --- ZEMĚ (VODOVROVNÁ ROVINA) ---
    \draw[thick] (-0.5,0) -- (7,0);
    \fill[pattern=north east lines, pattern color=gray!60] (-0.5,-0.2) rectangle (7,0);

    % --- VĚŽ (SCHEMATICKY) ---
    \draw[fill=gray!25, thick] (5.85,0) rectangle (6.15,4);
    % Popisek vrcholu V byl odstraněn podle požadavku.

    % --- ZORNÉ PAPRSKY ---
    \draw[thick, blue!80!black] (A) -- (V);
    \draw[thick, red!80!black] (B) -- (V);

    % --- BODY A POPISKY ---
    \fill (A) circle (2pt) node[below left] {$A$};
    \fill (B) circle (2pt) node[below left] {$B$};
    \fill (P) circle (2pt) node[below right] {$P$};
    \fill (V) circle (2pt) node[above] {$V$};

    % --- ÚHLY (pouze obloučky a symboly) ---
    % Úhel alpha (čistý oblouček bez šipky a hodnoty)
    \draw[thick, blue!80!black] (0.9,0) arc (0:33.7:0.9);
    % Upravená pozice pro samotný symbol alpha
    \node[blue!80!black] at (1.2,0.3) {$\alpha$};

    % Úhel beta (čistý oblouček bez šipky a hodnoty)
    \draw[thick, red!80!black] (4.2,0) arc (0:58:0.7);
    % Upravená pozice pro samotný symbol beta
    \node[red!80!black] at (4.4,0.4) {$\beta$};

    % --- KÓTA VZDÁLENOSTI 50 m ---
    \draw[<->, thick] (0,-0.6) -- (3.5,-0.6) node[midway, fill=white] {$50\text{ m}$};
    \draw[dotted] (A) -- (0,-0.7);
    \draw[dotted] (B) -- (3.5,-0.7);

    % --- KÓTA VÝŠKY VĚŽE (v) ---
    \draw[<->, thick] (6.7,0) -- (6.7,4) node[midway, fill=white] {$v = ?$};
    \draw[dotted] (V) -- (6.8,4);
    \draw[dotted] (P) -- (6.8,0);

\end{tikzpicture}
